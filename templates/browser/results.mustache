{{!
    @template repository_multipicker/browser/results
    @copyright 2026 Didactika.org
    @author Hector Arrechea <hectorlazaroarrechea@gmail.com>
    @license https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
    Example context (json): {"cards":[{"name":"Example folder","source":"example","folder":true}]}
}}

<div class="multipicker-items">
{{#cards}}
    <div class="multipicker-node" data-multipicker-node data-source="{{source}}">
        <div class="card" data-multipicker-card>
            <div class="card-body p-2">
                <div class="multipicker-card-tools d-flex align-items-center mb-2">
                    <input type="checkbox" class="mr-2" value="{{source}}" data-multipicker-check aria-label="{{name}}">
                    {{#folder}}{{#pix}}f/folder, core{{/pix}}<span class="badge badge-light ml-1">{{#str}}folder, repository_multipicker{{/str}}</span>{{/folder}}
                    {{^folder}}{{#pix}}f/document, core{{/pix}}<span class="badge badge-light ml-1">{{#str}}file, repository_multipicker{{/str}}</span>{{/folder}}
                    {{#folder}}<button type="button" class="btn btn-sm multipicker-open ml-auto" data-multipicker-open="{{source}}" aria-expanded="false" title="{{#str}}open, repository_multipicker{{/str}}" aria-label="{{#str}}open, repository_multipicker{{/str}}">{{#pix}}t/right, core{{/pix}}</button>{{/folder}}
                </div>
                <strong class="multipicker-name" title="{{name}}">{{name}}</strong>
                <div class="small text-muted border-top pt-2 mt-2 multipicker-meta">{{author}}{{#license}} · {{license}}{{/license}}{{#size}} · {{size}}{{/size}}</div>
            </div>
        </div>
        <div class="multipicker-children ml-3 pl-2 border-left" data-multipicker-children hidden></div>
    </div>
{{/cards}}
</div>
{{^cards}}<p class="text-muted text-center py-4">{{#str}}empty, repository_multipicker{{/str}}</p>{{/cards}}
