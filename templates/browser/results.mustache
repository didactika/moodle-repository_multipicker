{{!
    @template repository_multipicker/browser/results
    @copyright 2026 Didactika.org
    @author Hector Arrechea <hectorlazaroarrechea@gmail.com>
    @license https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
    Example context (json): {"cards":[]}
}}
<div class="row">
{{#cards}}
    <div class="col-12 col-md-6 mb-2">
        <div class="card h-100" data-multipicker-card>
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <label class="mb-0"><input type="checkbox" class="mr-2" value="{{source}}" data-multipicker-check aria-label="{{name}}">{{#folder}}{{#pix}}f/folder, core{{/pix}}{{/folder}}{{^folder}}{{#pix}}f/document, core{{/pix}}{{/folder}}</label>
                    {{#folder}}<button type="button" class="btn btn-sm btn-outline-primary" data-multipicker-open="{{source}}" title="{{#str}}open, repository_multipicker{{/str}}">{{#pix}}t/right, core{{/pix}}</button>{{/folder}}
                </div>
                <strong class="multipicker-name d-block" title="{{name}}">{{name}}</strong>
                <div class="small text-muted mt-2">{{size}}</div>
            </div>
        </div>
    </div>
{{/cards}}
</div>
{{^cards}}<p class="text-muted text-center py-4">{{#str}}empty, repository_multipicker{{/str}}</p>{{/cards}}
