{{!
    @template repository_multipicker/browser/results
    @copyright 2026 Didactika.org
    @author Hector Arrechea <hectorlazaroarrechea@gmail.com>
    @license https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
    Example context (json): {"cards":[{"name":"Example folder","source":"example","folder":true}]}
}}

<div class="multipicker-items">
{{#cards}}
    <div class="multipicker-node" data-multipicker-node data-source="{{source}}">
        <div class="card" data-multipicker-card>
            <div class="card-body d-flex align-items-start p-2">
                <input type="checkbox" value="{{source}}" data-multipicker-check aria-label="{{name}}">
                <div class="multipicker-card-content">
                    <div class="multipicker-card-tools d-flex align-items-center mb-1">
                        {{#folder}}{{#pix}}f/folder, core{{/pix}}<span class="badge text-bg-primary multipicker-chip">{{#str}}folder, repository_multipicker{{/str}}</span>{{/folder}}
                        {{^folder}}{{#pix}}f/document, core{{/pix}}<span class="badge text-bg-primary multipicker-chip">{{#str}}file, repository_multipicker{{/str}}</span>{{/folder}}
                    </div>
                    <strong class="multipicker-name" title="{{name}}">{{name}}</strong>
                    <div class="multipicker-meta d-flex flex-wrap mt-2 pt-2 border-top">
                        {{#folder}}<span class="badge text-bg-primary multipicker-chip" data-multipicker-folder-count="{{source}}">{{#str}}folderselection, repository_multipicker, 0{{/str}}</span>{{/folder}}
                        {{^folder}}<span>{{author}}{{#license}} · {{license}}{{/license}}{{#size}} · {{size}}{{/size}}</span>{{/folder}}
                    </div>
                </div>
                {{#folder}}<button type="button" class="btn btn-outline-primary multipicker-open" data-multipicker-open="{{source}}" aria-expanded="false" title="{{#str}}open, repository_multipicker{{/str}}" aria-label="{{#str}}open, repository_multipicker{{/str}}"><span class="multipicker-open-navigation">{{#pix}}t/right, core{{/pix}}</span><span class="multipicker-open-tree">{{#pix}}t/collapsed, core{{/pix}}</span></button>{{/folder}}
            </div>
        </div>
        <div class="multipicker-children ms-3 ps-2 border-start" data-multipicker-children hidden></div>
    </div>
{{/cards}}
</div>
{{^cards}}<p class="text-muted text-center py-4">{{#str}}empty, repository_multipicker{{/str}}</p>{{/cards}}
