{{!
    @template repository_multipicker/browser/review_node
    @copyright 2026 Didactika.org
    @author Hector Arrechea <hectorlazaroarrechea@gmail.com>
    @license https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
    Example context (json): {"name":"Example file", "source":"example", "standalone":true}
}}
{{#standalone}}<ul class="list-unstyled">{{/standalone}}
<li data-multipicker-reviewnode>
    <div class="d-flex align-items-center py-2 border-bottom" data-multipicker-reviewrow>
        <input type="checkbox" class="mr-2" value="{{source}}" data-multipicker-reviewcheck aria-label="{{name}}" {{#folder}}data-multipicker-reviewgroup{{/folder}}>
        {{#folder}}<button type="button" class="btn btn-sm btn-link px-1 mr-1" data-multipicker-reviewtoggle aria-expanded="true" aria-label="{{#str}}open, repository_multipicker{{/str}}">{{#pix}}t/expanded, core{{/pix}}</button>{{#pix}}f/folder, core{{/pix}}{{/folder}}
        {{^folder}}{{#pix}}f/document, core{{/pix}}{{/folder}}
        <strong class="small text-break ml-1">{{name}}</strong>
        {{^folder}}<span class="badge badge-light ml-auto">{{#aliases}}{{#str}}reference, repository_multipicker{{/str}}{{/aliases}}{{^aliases}}{{#str}}copy, repository_multipicker{{/str}}{{/aliases}}</span>{{/folder}}
    </div>
    {{#folder}}
    <ul class="list-unstyled ml-3 pl-2 border-left" data-multipicker-reviewchildren>
        {{#children}}{{> repository_multipicker/browser/review_node}}{{/children}}
    </ul>
    {{/folder}}
</li>
{{#standalone}}</ul>{{/standalone}}
