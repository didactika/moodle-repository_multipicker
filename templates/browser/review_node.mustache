{{!
    @template repository_multipicker/browser/review_node
    @copyright 2026 Didactika.org
    @author Hector Arrechea <hectorlazaroarrechea@gmail.com>
    @license https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
    Example context (json): {"name":"Example file", "source":"example", "path":"/", "standalone":true}
}}
{{#standalone}}<ul class="list-unstyled">{{/standalone}}
<li data-multipicker-reviewnode data-path="{{path}}">
    <div class="d-flex align-items-center py-2 border-bottom" data-multipicker-reviewrow>
        <input type="checkbox" class="multipicker-inline-end-gap" value="{{source}}" data-multipicker-reviewcheck aria-label="{{name}}" {{#folder}}data-multipicker-reviewgroup{{/folder}}>
        {{#folder}}<button type="button" class="btn btn-sm btn-link px-1 multipicker-inline-end-gap" data-multipicker-reviewtoggle aria-expanded="false" aria-label="{{#str}}open, repository_multipicker{{/str}}">{{#pix}}t/collapsed, core{{/pix}}</button>{{#pix}}i/folder, core{{/pix}}{{/folder}}
        {{^folder}}{{#pix}}i/files, core{{/pix}}{{/folder}}
        <strong class="small multipicker-reviewname multipicker-inline-start-gap" title="{{name}}">{{name}}</strong>
        <span class="badge bg-primary text-white multipicker-chip multipicker-push-end">{{#folder}}{{count}}{{/folder}}{{^folder}}{{#aliases}}{{#str}}reference, repository_multipicker{{/str}}{{/aliases}}{{^aliases}}{{#str}}copy, repository_multipicker{{/str}}{{/aliases}}{{/folder}}</span>
        <button type="button" class="btn btn-sm btn-link text-danger multipicker-inline-start-gap" data-multipicker-delete="{{source}}" title="{{#str}}remove, repository_multipicker{{/str}}" aria-label="{{#str}}remove, repository_multipicker{{/str}}">{{#pix}}t/delete, core{{/pix}}</button>
    </div>
    {{#folder}}<div class="multipicker-indent" data-multipicker-reviewchildren hidden></div>{{/folder}}
</li>
{{#standalone}}</ul>{{/standalone}}
